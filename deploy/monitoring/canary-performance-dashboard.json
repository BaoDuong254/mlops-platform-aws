{
  "uid": "m33-canary",
  "title": "Canary Deployment & Performance",
  "description": "Live Prometheus metrics; no CSV or simulated values.",
  "tags": [
    "mlops",
    "realtime"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Inference Load & HPA",
      "url": "/d/m33-load-hpa",
      "type": "link"
    },
    {
      "title": "Canary Deployment & Performance",
      "url": "/d/m33-canary",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 2,
      "title": "Request Rate by ReplicaSet",
      "description": "1 m rate; 0.2 RPS is the candidate minimum from AnalysisTemplate.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rollouts_pod_template_hash) (rate(inference_http_requests_total{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\"}[1m]))",
          "legendFormat": "RS {{rollouts_pod_template_hash}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "P95 Latency by ReplicaSet",
      "description": "2 m rate matches AnalysisTemplate. Absolute candidate limit is 500 ms; relative gate also applies.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, rollouts_pod_template_hash) (rate(inference_http_request_duration_seconds_bucket{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\"}[2m])))",
          "legendFormat": "RS {{rollouts_pod_template_hash}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP 5xx Error Rate by ReplicaSet",
      "description": "App 5xx only. Absent error series is zero only for an RS with observed requests; no traffic is No data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum by (rollouts_pod_template_hash) (rate(inference_http_errors_total{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\",status=~\"5..\"}[1m])) or (0 * sum by (rollouts_pod_template_hash) (rate(inference_http_requests_total{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\"}[1m])))) / (sum by (rollouts_pod_template_hash) (rate(inference_http_requests_total{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\"}[1m])) > 0))",
          "legendFormat": "RS {{rollouts_pod_template_hash}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    }
  ]
}
