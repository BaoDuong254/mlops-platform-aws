{
  "uid": "m33-load-hpa",
  "title": "Inference Load & HPA",
  "description": "Live Prometheus metrics; no CSV or simulated values.",
  "tags": [
    "mlops",
    "realtime"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Inference Load & HPA",
      "url": "/d/m33-load-hpa",
      "type": "link"
    },
    {
      "title": "Canary Deployment & Performance",
      "url": "/d/m33-canary",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 2,
      "title": "Request Throughput — /predict",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inference_http_requests_total{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\"}[1m]))",
          "legendFormat": "Observed throughput",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "CPU Utilization vs HPA Target",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_target_metric{job=\"mlops-state\",namespace=\"mlops\",horizontalpodautoscaler=\"inference-api\",metric_name=\"cpu\",metric_target_type=\"utilization\"}",
          "legendFormat": "CPU utilization / requests",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_spec_target_metric{job=\"mlops-state\",namespace=\"mlops\",horizontalpodautoscaler=\"inference-api\",metric_name=\"cpu\",metric_target_type=\"utilization\"}",
          "legendFormat": "HPA CPU target",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMax": 100
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HPA CPU target"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    8
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "HPA Replicas — Current / Desired",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{job=\"mlops-state\",namespace=\"mlops\",horizontalpodautoscaler=\"inference-api\"}",
          "legendFormat": "Current replicas",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{job=\"mlops-state\",namespace=\"mlops\",horizontalpodautoscaler=\"inference-api\"}",
          "legendFormat": "Desired replicas",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "P95 Latency — /predict",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(inference_http_request_duration_seconds_bucket{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\"}[2m])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP 5xx Error Rate — /predict",
      "description": "Zero only when requests were observed and no app 5xx occurred; empty at zero traffic. ALB-generated errors are not app metrics.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(rate(inference_http_errors_total{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\",status=~\"5..\"}[1m])) or (0 * sum(rate(inference_http_requests_total{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\"}[1m])))) / (sum(rate(inference_http_requests_total{job=\"inference-api\",namespace=\"mlops\",path=\"/predict\"}[1m])) > 0))",
          "legendFormat": "HTTP 5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    }
  ]
}
